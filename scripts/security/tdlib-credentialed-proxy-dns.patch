+void ConnectionCreator::resolve_proxy_host(const Proxy &proxy, bool authenticated_proxy, bool prefer_ipv6,
+                                           Promise<IPAddress> promise) {
+  if (authenticated_proxy) {
+    IPAddress ip_address;
+    auto status = ip_address.init_ipv4_port(proxy.server(), proxy.port());
+    if (status.is_error()) {
+      status = ip_address.init_ipv6_port(proxy.server(), proxy.port());
+    }
+    if (status.is_ok()) {
+      return promise.set_value(std::move(ip_address));
+    }
+  }
+  send_closure(get_dns_resolver(authenticated_proxy), &GetHostByNameActor::run, proxy.server().str(), proxy.port(),
+               prefer_ipv6, std::move(promise));
